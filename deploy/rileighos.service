[Unit]
Description=rileighos personal productivity server
Documentation=file:///usr/local/share/doc/rileighos/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Single source of truth: SQLite file on the Pi. StateDirectory=rileighos
# creates /var/lib/rileighos (systemd-agnostic persistent state dir) owned
# by this service's user, so --db stays valid across Pi OS reinstalls of
# the package without hardcoding a home directory.
ExecStart=/usr/local/bin/rileighos serve --backend sqlite --db /var/lib/rileighos/rileighos.db --addr :8080
Restart=always
RestartSec=2
# Replace `pi` with your actual Pi login user if different (`whoami`).
# StateDirectory ownership follows this user automatically.
User=pi
StateDirectory=rileighos
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rileighos

[Install]
WantedBy=multi-user.target
